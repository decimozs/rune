# OCR Engine Settings
# Enable Intel MKL-DNN CPU acceleration (true/false)
OCR_ENABLE_MKLDNN=false

# OCR language code (e.g., en, zh, ja)
OCR_LANG=en

# PaddleOCR model version
OCR_VERSION=PP-OCRv4

# Enable textline orientation detection (true/false)
OCR_USE_TEXTLINE_ORIENTATION=true

# File Upload Settings
# Maximum upload file size in bytes (default: 50MB = 52428800)
OCR_MAX_FILE_SIZE=52428800

# Directory for temporary upload files
OCR_UPLOAD_DIR=/tmp

# Comma-separated list of allowed MIME types
OCR_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/bmp,image/tiff,image/webp,application/pdf,application/msword

# Gotenberg Settings
# URL of the Gotenberg document conversion API
OCR_GOTENBERG_URL=http://localhost:3000

# Output Settings
# Directory for markdown output files
OCR_OUTPUT_DIR=app/outputs

# Auth Settings
# Comma-separated API keys. Use "key=name" format for audit identity.
# Set to "#" (default) to disable auth for local dev.
# OCR_API_KEYS=sk-prod-abc123,sk-prod-def456
# OCR_API_KEYS=sk-abc=alice,sk-def=bob

# SQLite DB path for hashed API key storage (recommended).
# When set, keys are stored as SHA-256 hashes and managed via scripts/create_api_key.py.
# New keys work immediately — no server restart.
# Alias keys from OCR_API_KEYS are auto-migrated on first startup.
# Leave empty for env-var-only auth (legacy).
# OCR_DB_PATH=app/data/ocr.db

# URL Safety Settings
# Maximum URL length for /ocr/parse/url endpoints
OCR_URL_MAX_LENGTH=2048

# Comma-separated list of blocked domains (exact match only)
# OCR_URL_BLOCKED_DOMAINS=internal.corp,admin.local

# Comma-separated list of allowed domains (exact or subdomain match)
# OCR_URL_ALLOWED_DOMAINS=example.com,example.org

# When true, only domains in OCR_URL_ALLOWED_DOMAINS are permitted
OCR_COMPANY_DOMAINS_ONLY=false

# CORS Settings
# Comma-separated list of allowed origins for browser CORS.
# Set to your client domain in production (e.g., https://ocr.example.com).
# Default "*" allows all origins (local dev only).
OCR_CORS_ORIGINS=*

# Rate Limiting
# Max requests per minute per client. Comment out to disable.
# OCR_RATE_LIMIT=100/minute

# Logging Settings
# Log level: DEBUG, INFO, WARNING, ERROR
OCR_LOG_LEVEL=INFO
